<?xml version="1.0" encoding="UTF-8"?>

<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    colors="true"
    executionOrder="random"
    failOnDeprecation="true"
    failOnNotice="true"
    failOnWarning="true"
    bootstrap="../../tests/bootstrap.php"
    cacheDirectory="../../var/cache/phpunit"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <server name="APP_SECRET" value="$ecretf0rt3st" force="true" />
        <server name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/empires_test.db" force="true" />
        <!-- Lets a functional test stand in for Traefik and assert the forwarded scheme is honoured.
             Production's literal REMOTE_ADDR cannot be used here: Request::setTrustedProxies() swaps
             that token for $_SERVER['REMOTE_ADDR'], which does not exist under CLI, and drops the
             entry entirely. 127.0.0.1 is the address BrowserKit gives its simulated requests. -->
        <server name="TRUSTED_PROXIES" value="127.0.0.1" force="true" />
    </php>

    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    </extensions>

    <testsuites>
        <testsuite name="default">
            <directory>../../tests</directory>
        </testsuite>
    </testsuites>

    <source
        ignoreSuppressionOfDeprecations="true"
        ignoreIndirectDeprecations="true"
        restrictNotices="true"
        restrictWarnings="true"
    >
        <include>
            <directory>../../src</directory>
        </include>

        <deprecationTrigger>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>
</phpunit>
