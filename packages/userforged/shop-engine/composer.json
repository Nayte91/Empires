{
    "name": "userforged/shop-engine",
    "description": "Ordering engine (catalog, cart, checkout) — canonical shop pattern, ports-based, framework-agnostic core.",
    "type": "symfony-bundle",
    "version": "2.0.0",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Userforged\\ShopEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Userforged\\ShopEngine\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/workflow": "^8.1",

        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.6"
    },
    "require-dev": {
        "symfony/framework-bundle": "^8.1",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^13.2",
        "rector/rector": "^2.4"
    },
    "suggest": {
        "symfony/framework-bundle": "To register UserforgedShopEngineBundle — a Symfony bundle is an adapter, not the core; the engine itself needs no framework."
    },
    "scripts": {
        "rector": "vendor/bin/rector process --config=config/tools/rector.php",
        "phpcs": "vendor/bin/php-cs-fixer fix --config=config/tools/php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=config/tools/phpstan.php --memory-limit=1G",
        "phpunit": "vendor/bin/phpunit --configuration=config/tools/phpunit.xml"
    }
}
