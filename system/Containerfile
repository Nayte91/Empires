###> Base FrankenPHP image
FROM dunglas/frankenphp:1-php8.5 AS frankenphp_base

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends file git && \
    install-php-extensions @composer apcu intl opcache yaml zip

ENV COMPOSER_ALLOW_SUPERUSER=1 PHP_INI_SCAN_DIR=":$PHP_INI_DIR/app.conf.d"

COPY --link system/backend/php.ini $PHP_INI_DIR/app.conf.d/10-app.ini
COPY --link system/webserver/Caddyfile /etc/frankenphp/Caddyfile

HEALTHCHECK --start-period=60s CMD php -r 'exit(false === @file_get_contents("http://localhost:2019/metrics", context: stream_context_create(["http" => ["timeout" => 5]])) ? 1 : 0);'
CMD [ "frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile" ]
###< Base FrankenPHP image


###> Dev FrankenPHP image
FROM frankenphp_base AS frankenphp_dev

ENV APP_ENV=dev
ENV XDEBUG_MODE=off

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini" && \
    apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    install-php-extensions xdebug ast

COPY --link system/backend/php.dev.ini $PHP_INI_DIR/app.conf.d/20-app.dev.ini

HEALTHCHECK --start-period=60s CMD XDEBUG_MODE=off php -r 'exit(false === @file_get_contents("http://localhost:2019/metrics", context: stream_context_create(["http" => ["timeout" => 5]])) ? 1 : 0);'

CMD [ "frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile", "--watch" ]
###< Dev FrankenPHP image


###> Library collector (parallel with prod_builder, depends only on base)
FROM frankenphp_base AS frankenphp_libs

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends libtree && \
    mkdir -p /tmp/libs && \
    BINARIES=(frankenphp php file) && \
    for target in \
        $(printf '%s\n' "${BINARIES[@]}" | xargs -I{} which {}) \
        $(find "$(php -r 'echo ini_get("extension_dir");')" -maxdepth 2 -name "*.so"); do \
        libtree -pv "$target" 2>/dev/null | grep -oP '(?:── )\K/\S+(?= \[)' | while IFS= read -r lib; do \
            [ -f "$lib" ] && cp -n "$lib" /tmp/libs/; \
        done; \
    done
###< Library collector


###> Prod builder
FROM frankenphp_base AS frankenphp_prod_builder

ENV APP_ENV=prod

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --link system/backend/php.prod.ini $PHP_INI_DIR/app.conf.d/20-app.prod.ini

COPY --link composer.* symfony.* ./
RUN --mount=type=cache,target=/root/.composer/cache \
    composer install --prefer-dist --no-dev --no-autoloader --no-scripts --no-progress

COPY --link . ./

RUN <<-EOF
	mkdir -p var/cache var/log
	composer dump-autoload --classmap-authoritative --no-dev
	composer run-script --no-dev post-install-cmd
	php bin/console asset-map:compile
	chmod +x bin/console; sync
EOF

RUN strip --strip-unneeded /usr/local/bin/frankenphp /usr/local/bin/php || true
###< Prod builder


###> Prod FrankenPHP image (rootless, slim)
FROM debian:13-slim AS frankenphp_prod

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ENV APP_ENV=prod
ENV PHP_INI_SCAN_DIR=":/usr/local/etc/php/app.conf.d"

COPY --link --from=frankenphp_prod_builder /usr/local/bin/frankenphp /usr/local/bin/frankenphp
COPY --link --from=frankenphp_prod_builder /usr/local/bin/php /usr/local/bin/php
COPY --link --from=frankenphp_prod_builder /usr/local/bin/docker-php-entrypoint /usr/local/bin/docker-php-entrypoint
COPY --link --from=frankenphp_prod_builder /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --link --from=frankenphp_libs /tmp/libs /usr/lib

COPY --link --from=frankenphp_prod_builder /usr/local/etc/php/conf.d /usr/local/etc/php/conf.d
COPY --link --from=frankenphp_prod_builder /usr/local/etc/php/php.ini /usr/local/etc/php/php.ini
COPY --link --from=frankenphp_prod_builder /usr/local/etc/php/app.conf.d /usr/local/etc/php/app.conf.d
COPY --link system/backend/php.prod.final.ini /usr/local/etc/php/app.conf.d/25-app.prod.final.ini

COPY --link --from=frankenphp_prod_builder /etc/frankenphp/Caddyfile /etc/frankenphp/Caddyfile

# CA certificates for TLS, file/libmagic for Symfony MIME type detection
COPY --link --from=frankenphp_prod_builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN mkdir -p /usr/lib/ssl && \
    ln -sf /etc/ssl/certs/ca-certificates.crt /usr/lib/ssl/cert.pem && \
    ln -sf /etc/ssl/certs /usr/lib/ssl/certs
COPY --link --from=frankenphp_prod_builder /usr/bin/file /usr/bin/file
COPY --link --from=frankenphp_prod_builder /usr/lib/file/magic.mgc /usr/lib/file/magic.mgc

ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data

RUN mkdir -p /data/caddy /config/caddy && \
    chown -R www-data:www-data /data /config && \
    find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

COPY --link --exclude=var --from=frankenphp_prod_builder /app /app
COPY --link --chown=33:33 --from=frankenphp_prod_builder /app/var /app/var

RUN chown www-data:www-data /app/public && \
    mkdir -p /app/system/database && chown www-data:www-data /app/system/database

EXPOSE 80

USER www-data

WORKDIR /app

HEALTHCHECK --start-period=60s CMD php -r 'exit(false === @file_get_contents("http://localhost:2019/metrics", context: stream_context_create(["http" => ["timeout" => 5]])) ? 1 : 0);'
CMD [ "frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile" ]
###< Prod FrankenPHP image
