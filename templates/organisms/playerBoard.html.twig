<main
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: board_topic(player)})) }}
    class="player-board"
>
    <twig:molecules:PlayerHeading :player="player" />

    <twig:molecules:ControlBoard :player="player" :withShopLink="true" />

    <div class="panels">
        <twig:molecules:Outlook :player="player" />

        <twig:molecules:Discounts :player="player" :open="true" />
    </div>

    <section aria-label="Owned advances">
        {% set advancePoints = this.advancePoints %}
        <h2>Advances ({{ advancePoints }} Victory Point{{ advancePoints == 1 ? '' : 's' }})</h2>

        <div class="advances-grid">
            {% for advance in this.ownedAdvances %}
                <img id="product-{{ advance.key }}" src="{{ advance.fileName }}" alt="{{ advance.name }} card" loading="lazy">
            {% else %}
                <p>No advance owned yet.</p>
            {% endfor %}
        </div>
    </section>
</main>
