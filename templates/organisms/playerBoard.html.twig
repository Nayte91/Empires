<div
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ player.game.id, events: ['player-updated']})) }}
    class="player-board"
>
    <header class="player-board__header">
        <h1>{{ player.name }} — {{ player.empire ?? '—' }}</h1>

        <a href="{{ this.shopUrl }}" class="player-board__shop-link">Shop</a>
    </header>

    <section class="player-board__stats" aria-label="Stats">
        <twig:molecules:StatPicker :player="player" stat="cities" :value="player.cities" />

        <twig:molecules:StatPicker :player="player" stat="ships" :value="player.ships" />

        <twig:molecules:StatPicker :player="player" stat="census" :value="player.census" />

        <twig:molecules:StatPicker :player="player" stat="treasury" :value="player.treasury" />

        <twig:molecules:StatPicker :player="player" stat="cards" :value="player.cards" />
    </section>

    <h2>Discounts</h2>

    <twig:molecules:Discounts :player="player" />

    <section class="player-board__advances" aria-label="Owned advances">
        <h2>Advances</h2>

        <div class="player-board__advances-grid">
            {% for product in this.ownedProducts %}
                {% include 'molecules/productCard.html.twig' with {product, readonly: true} only %}
            {% else %}
                <p>No advance owned yet.</p>
            {% endfor %}
        </div>
    </section>
</div>
