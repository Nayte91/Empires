<div
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ player.game.id, events: ['player-updated', 'order-validated']})) }}
    class="player-board"
>
    <header class="player-board__header">
        <h1>{{ player.name }} — {{ player.empire ?? '—' }}</h1>

        <a href="{{ this.shopUrl }}" class="player-board__shop-link">Shop</a>
    </header>

    <section class="player-board__stats" aria-label="Stats">
        <span class="player-board__stepper">
            Cities
            <button type="button" {{ live_action('adjustCities', {delta: -1}) }} data-loading="addAttribute(disabled)">−</button>
            <span class="player-board__stepper-value">{{ player.cities }}</span>
            <button type="button" {{ live_action('adjustCities', {delta: 1}) }} data-loading="addAttribute(disabled)">+</button>
        </span>

        <span class="player-board__stepper">
            Ships
            <button type="button" {{ live_action('adjustShips', {delta: -1}) }} data-loading="addAttribute(disabled)">−</button>
            <span class="player-board__stepper-value">{{ player.ships }}</span>
            <button type="button" {{ live_action('adjustShips', {delta: 1}) }} data-loading="addAttribute(disabled)">+</button>
        </span>

        <label class="player-board__stepper">
            Census
            <input type="number" min="{{ constant('App\\Entity\\Player::CENSUS_MIN') }}" max="{{ constant('App\\Entity\\Player::CENSUS_MAX') }}" data-model="debounce(300)|census" value="{{ census }}">
        </label>

        <label class="player-board__stepper">
            Treasury
            <input type="number" min="{{ constant('App\\Entity\\Player::TREASURY_MIN') }}" max="{{ constant('App\\Entity\\Player::TREASURY_MAX') }}" data-model="debounce(300)|treasury" value="{{ treasury }}">
        </label>

        <label class="player-board__stepper">
            Cards
            <input type="number" min="{{ constant('App\\Entity\\Player::CARDS_MIN') }}" data-model="debounce(300)|cards" value="{{ cards }}">
        </label>
    </section>

    <h2>Discounts</h2>

    <twig:molecules:Discounts :player="player" />

    <section class="player-board__advances" aria-label="Owned advances">
        <h2>Advances</h2>

        <div class="player-board__advances-grid">
            {% for product in this.ownedProducts %}
                {% include 'molecules/productCard.html.twig' with {product, readonly: true} only %}
            {% else %}
                <p>No advance owned yet.</p>
            {% endfor %}
        </div>
    </section>
</div>
