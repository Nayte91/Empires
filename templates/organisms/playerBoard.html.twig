{% set title = player.name %}
{% set subtitle = player.empire|capitalize %}

<main
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ player.game.id, events: ['player-updated']})) }}
    class="player-board"
>
    <twig:atoms:PageTitle :title="title" :subtitle="subtitle" />

    <twig:molecules:ControlBoard :player="player" :withShopLink="true" />

    <div class="player-board__panels">
        <section aria-label="Discounts">
            <h2>Discounts</h2>

            <twig:molecules:Discounts :player="player" />
        </section>

        <section aria-label="Outlook">
            <h2>Outlook</h2>

            <twig:molecules:Outlook :player="player" />
        </section>
    </div>

    <section class="player-board__advances" aria-label="Owned advances">
        <h2>Advances</h2>

        <div class="player-board__advances-grid">
            {% for row in this.ownedRows %}
                {% include 'molecules/productCard.html.twig' with {row, readonly: true} only %}
            {% else %}
                <p>No advance owned yet.</p>
            {% endfor %}
        </div>
    </section>
</main>
