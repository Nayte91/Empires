{% set cart = this %}

<div {{ attributes }}>
    <section class="cart panel" data-status="{{ status }}">
        <twig:atoms:Label>Cart</twig:atoms:Label>

        {% if hint %}
            <twig:atoms:Hint>{{ hint }}</twig:atoms:Hint>
        {% endif %}

        <ul class="lines">
            {% for row in this.lines %}
                <twig:molecules:TicketLine :row="row">
                    <button
                        type="button"
                        {{ live_action('remove', {key: row.advance.key}) }}
                        data-loading="addAttribute(disabled)"
                        class="button quiet"
                    >
                        ×
                    </button>

                    {% if row.advance.promotion and row.advance.promotion.gift is not empty %}
                        {% include 'molecules/gift_picker.html.twig' with {
                            row: row,
                            candidates: cart.getGiftCandidates(row.advance.key),
                            chosenGift: cart.getChosenGiftFor(row.advance.key),
                        } only %}
                    {% endif %}

                    {% if row.advance.promotion and row.advance.promotion.option is not null %}
                        {% include 'molecules/allocation_picker.html.twig' with {
                            row: row,
                            remaining: cart.getAllocationRemaining(row.advance.key),
                            allocation: cart.getAllocationFor(row.advance.key),
                        } only %}
                    {% endif %}
                </twig:molecules:TicketLine>
            {% else %}
                <li class="empty" data-empty>Cart is empty.</li>
            {% endfor %}
        </ul>

        <p class="total">Total: {{ this.total }}</p>

        {% if error %}
            <p class="shop__error" role="alert">{{ error }}</p>
        {% endif %}

        {% set isDisabled = locked or this.isEmpty or this.hasIncompleteAllocations %}
        <footer>
            <button
                type="button"
                {{ live_action('checkout') }}
                {{ isDisabled ? 'disabled' }}
                {% if not isDisabled %}data-loading="addAttribute(disabled)"{% endif %}
                class="button submit"
            >
                {{ checkoutLabel }}
            </button>

            {% if clearable %}
                {% set isClearDisabled = this.isEmpty %}
                <button
                    class="button"
                    type="button"
                    {{ live_action('clear') }}
                    {{ isClearDisabled ? 'disabled' }}
                    {% if not isClearDisabled %}data-loading="addAttribute(disabled)"{% endif %}
                >
                    {{ clearLabel }}
                </button>
            {% endif %}
        </footer>
        </section>
</div>
