{% set orders = this %}

<twig:molecules:Modal
    :id="'pos-' ~ player.id"
    open
    class="pos-dialog"
    aria-labelledby="pos-heading-{{ player.id }}"
    data-controller="modal"
    data-action="close->live#action"
    data-live-action-param="closePos"
>
    <h2 id="pos-heading-{{ player.id }}">Order — {{ player.name }} — Turn {{ posTurn }}</h2>

    {% if error %}
        <p role="alert">{{ error }}</p>
    {% endif %}

    {% set posOrder = orders.posOrder %}
    {% set isValidated = posOrder and posOrder.status.value == 'validated' %}

    <div class="summary">
        <twig:molecules:Discounts :player="player" />

        {% if not isValidated %}
            <twig:Cart
                :player="player"
                :cartStamp="orders.getCartStamp()"
                :directSale="true"
                :window="posTurn"
                checkoutLabel="Confirm purchase"
                :storageKey="orders.posCartKey"
            />
        {% endif %}
    </div>

    {% if isValidated %}
        <p role="status">Order validated.</p>

        <button
    class="button" type="button" {{ live_action('closePos') }} data-loading="addAttribute(disabled)">
            Close
        </button>
    {% else %}
        <twig:organisms:Catalog :player="player" :storageKey="orders.posCartKey" :view="orders.catalogView" />
    {% endif %}
</twig:molecules:Modal>
