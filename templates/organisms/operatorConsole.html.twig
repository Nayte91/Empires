{% set title = game.slug %}
{% set subtitle = 'Turn ' ~ game.currentTurn ~ (game.finished ? ' — finished' : '') %}

<main
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id})) }}
    class="operator-console"
>
    <twig:atoms:PageTitle :title="title" :subtitle="subtitle" />

    <div class="tab-group">
        {% embed 'atoms/tab.html.twig' with {
            group: 'operator-tabs',
            tabId: 'general',
            label: 'General',
            open: true,
        } %}
            {% block panel %}
                <div class="operator-console__turn-controls">
                    {% if game.finished %}
                        <span class="operator-console__finished-badge">Finished</span>
                    {% else %}
                        <button
                            type="button"
                            {{ live_action('previousTurn') }}
                            {{ game.currentTurn == 1 ? 'disabled' }}
                        >
                            « Previous turn
                        </button>
                        <button
                            type="button"
                            {{ live_action('nextTurn') }}
                            data-loading="addAttribute(disabled)"
                        >
                            Next turn »
                        </button>
                        <button
                            type="button"
                            {{ live_action('finishGame') }}
                            data-loading="addAttribute(disabled)"
                        >
                            Finish game
                        </button>
                    {% endif %}
                </div>

                {% if not game.finished %}
                    <div class="operator-batch">
                        {% for player in game.players %}
                            <div data-player-id="{{ player.id }}" data-empire="{{ player.empire }}">
                                <p><b>{{ player.empire|capitalize }}</b> <small>({{ player.name }})</small></p>

                                {# Deliberately shorter than this player's own tab below: this block is
                                   the game-tracking overview — how far along is each empire — while
                                   economy management stays one click away, in the player's own tab.
                                   Do not "fix" the divergence back. #}
                                <twig:molecules:ControlBoard
                                    :player="player"
                                    :stats="['cities', 'astPosition', 'census']"
                                    scope="overview"
                                />
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {% for player in game.players %}
            {% embed 'atoms/tab.html.twig' with {
                group: 'operator-tabs',
                tabId: player.id,
                label: player.empire|empire_demonym|capitalize,
                empire: player.empire,
            } %}
                {% block panel %}
                    <h3>{{ player.name }}</h3>

                    <twig:molecules:ControlBoard
                        :player="player"
                        :stats="['cities', 'astPosition', 'census', 'treasury', 'ships', 'cards']"
                    />

                    <twig:PlayerOrders :player="player" :ordersStamp="this.ordersStampFor(player)" />
                {% endblock %}
            {% endembed %}
        {% endfor %}
    </div>
</main>
