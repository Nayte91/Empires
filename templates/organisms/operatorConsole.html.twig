{% set title = game.slug %}
{% set subtitle = 'Turn ' ~ game.currentTurn %}

<main
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id})) }}
    class="operator-console"
>
    <twig:atoms:PageTitle :title="title" :subtitle="subtitle" />

    <section class="operator-console__players">
        <h2>Players</h2>

        <div class="tab-group">
            {% embed 'atoms/tab.html.twig' with {
                group: 'operator-tabs',
                tabId: 'general',
                label: 'General',
                open: true,
            } %}
                {% block panel %}
                    <div class="operator-console__turn-controls">
                        {% if game.finished %}
                            <span class="operator-console__finished-badge">Finished</span>
                        {% else %}
                            <button
                                type="button"
                                {{ live_action('previousTurn') }}
                                {{ game.currentTurn == 1 ? 'disabled' }}
                            >
                                « Previous turn
                            </button>
                            <button
                                type="button"
                                {{ live_action('nextTurn') }}
                                data-loading="addAttribute(disabled)"
                            >
                                Next turn »
                            </button>
                            <button
                                type="button"
                                {{ live_action('finishGame') }}
                                data-loading="addAttribute(disabled)"
                            >
                                Finish game
                            </button>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}

            {% for player in game.players %}
                {% embed 'atoms/tab.html.twig' with {
                    group: 'operator-tabs',
                    tabId: player.id,
                    label: player.empire|empire_demonym|capitalize,
                    empire: player.empire,
                } %}
                    {% block panel %}
                        <h3>{{ player.name }}</h3>

                        <div class="operator-console__player-stat">
                            <twig:molecules:StatPicker :player="player" stat="cities" :value="player.cities" />
                            <twig:molecules:StatPicker :player="player" stat="astPosition" :value="player.astPosition" />
                            <twig:molecules:StatPicker :player="player" stat="census" :value="player.census" />
                            <twig:molecules:StatPicker :player="player" stat="treasury" :value="player.treasury" />
                            <twig:molecules:StatPicker :player="player" stat="ships" :value="player.ships" />
                            <twig:molecules:StatPicker :player="player" stat="cards" :value="player.cards" />
                        </div>

                        <twig:PlayerOrders :player="player" :ordersStamp="this.ordersStampFor(player)" />
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        </div>
    </section>
</main>
