{% props game %}

<main class="game-chronicle">
    <section id="panel-nav" aria-label="Navigation">
        <twig:Navigation :game="game" />
    </section>

    <section id="panel-ast" aria-label="Archaeological Succession Timeline">
        <twig:atoms:SectionTitle><a href="#ast">Archaeological Succession Timeline</a></twig:atoms:SectionTitle>
        <twig:Ast :game="game" />
    </section>

    <section id="panel-evolution" aria-label="Evolution">
        <twig:atoms:SectionTitle><a href="#evolution">Evolution</a></twig:atoms:SectionTitle>
        <twig:Evolution :game="game" />
    </section>
</main>
