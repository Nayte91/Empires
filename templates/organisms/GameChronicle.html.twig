{% props game %}

<main class="game-chronicle">
    <twig:atoms:PageTitle :title="game.slug" />

    <section id="panel-nav" aria-label="Navigation">
        <twig:Navigation :game="game" />
    </section>

    <section id="panel-ast" aria-label="Archaeological Succession Timeline">
        <h2>Archaeological Succession Timeline</h2>
        <twig:Ast :game="game" />
    </section>

    <section id="panel-evolution" aria-label="Evolution">
        <h2><a href="#evolution">Evolution</a></h2>
        <twig:Evolution :game="game" />
    </section>

    <menu class="tab-bar">
        <li>
            <input type="radio" name="tab" id="tab-ast" value="ast" checked hidden>
            <label for="tab-ast">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16"/><circle cx="9" cy="12" r="2.5"/><circle cx="16" cy="12" r="2.5"/></svg>
                Ranking
            </label>
        </li>
        <li>
            <input type="radio" name="tab" id="tab-evolution" value="evolution" hidden>
            <label for="tab-evolution">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 17l5-5 4 3 7-8"/></svg>
                Evolution
            </label>
        </li>
        <li>
            <input type="radio" name="tab" id="tab-nav" value="nav" hidden>
            <label for="tab-nav">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                Navigation
            </label>
        </li>
    </menu>
</main>
