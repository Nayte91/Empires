<main class="game-dashboard">
    <twig:atoms:PageTitle :heading="game.slug" :qualifier="'Turn ' ~ game.currentTurn" />

    <section id="panel-roster" aria-label="Roster">
        <twig:atoms:SectionTitle><a href="#roster">Roster</a></twig:atoms:SectionTitle>
        <twig:Turbo:Stream:From :topics="roster_topic(game)" />
        <twig:Roster :game="game" />
    </section>

    <section id="panel-ast" aria-label="Archaeological Succession Timeline">
        <twig:atoms:SectionTitle><a href="#ast">Archaeological Succession Timeline</a></twig:atoms:SectionTitle>
        <twig:Turbo:Stream:From :topics="ast_topic(game)" />
        <twig:Ast :game="game" />
        <twig:molecules:AstRequirements :eras="this.astEras" :astVersion="game.astVersion.value" />
    </section>

    <section id="panel-nav" aria-label="Navigation">
        <twig:atoms:SectionTitle><a href="#nav">Navigation</a></twig:atoms:SectionTitle>
        <twig:Navigation :game="game" />
    </section>

    <section id="panel-help" aria-label="Help">
        <twig:atoms:SectionTitle><a href="#help">Help</a></twig:atoms:SectionTitle>
        <twig:Help :game="game" />
    </section>

    <menu class="tab-bar">
        <li>
            <input type="radio" name="tab" id="tab-roster" value="roster" checked hidden>
            <label for="tab-roster">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 19v-6M10 19V7M15 19v-9M20 19V9"/></svg>
                Roster
            </label>
        </li>
        <li>
            <input type="radio" name="tab" id="tab-ast" value="ast" hidden>
            <label for="tab-ast">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16"/><circle cx="9" cy="12" r="2.5"/><circle cx="16" cy="12" r="2.5"/></svg>
                A.S.T.
            </label>
        </li>
        <li>
            <input type="radio" name="tab" id="tab-nav" value="nav" hidden>
            <label for="tab-nav">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                Navigation
            </label>
        </li>
        <li>
            <input type="radio" name="tab" id="tab-help" value="help" hidden>
            <label for="tab-help">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.2 2.4c-.7.25-1.2.9-1.2 1.6v.5"/><path d="M11.5 17.5h1"/></svg>
                Help
            </label>
        </li>
    </menu>
</main>
