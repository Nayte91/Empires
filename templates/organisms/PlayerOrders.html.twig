<div {{ attributes }} class="player-orders">
    <section aria-label="Orders per turn">
        {% for card in this.cards %}
            <twig:molecules:OrderCard
                :status="card.status"
                :turn="card.turn"
                :slugs="card.slugs"
                :total="card.total"
                :vp="card.vp"
            >
                {% if card.status == 'validated' %}
                    <button
                        class="button"
                        type="button"
                        commandfor="erase-confirm-{{ player.id }}-{{ card.turn }}"
                        command="show-modal"
                    >
                        Empty
                    </button>

                    <twig:molecules:Modal :id="'erase-confirm-' ~ player.id ~ '-' ~ card.turn">
                        <form method="dialog">
                            {% if card.turn == player.game.currentTurn %}
                                <p>Empty turn {{ card.turn }}?</p>
                            {% elseif card.turn + 1 == player.game.currentTurn %}
                                <p>Emptying turn {{ card.turn }} will also empty turn {{ card.turn + 1 }}.</p>
                            {% else %}
                                <p>
                                    Emptying turn {{ card.turn }} will also empty turns
                                    {{ card.turn + 1 }}…{{ player.game.currentTurn }}.
                                </p>
                            {% endif %}
                            <menu>
                                <li>
                                    <button class="button" type="button" command="close" commandfor="erase-confirm-{{ player.id }}-{{ card.turn }}">
                                        Cancel
                                    </button>
                                </li>
                                <li>
                                    <button class="button" type="submit" {{ live_action('eraseOrder', {turn: card.turn}) }}>
                                        Confirm
                                    </button>
                                </li>
                            </menu>
                        </form>
                    </twig:molecules:Modal>
                {% else %}
                    <a class="button" href="{{ path('app_operator_pos', {slug: player.game.slug, player: player.slug, turn: card.turn}) }}">
                        {{ card.status == 'pending' ? 'Verify' : (card.status == 'missing' ? 'Buy' : 'Edit') }}
                    </a>
                {% endif %}
            </twig:molecules:OrderCard>
        {% endfor %}
    </section>
</div>
