{% set title = 'Create a new game' %}

<main {{ attributes }} class="game-creator">
    <twig:atoms:PageTitle :title="title" />

    {% if error %}
        <p class="game-creator__error" data-error role="alert">{{ error }}</p>
    {% endif %}

    <fieldset class="game-creator__scenario">
        <legend>Scenario</legend>

        <label>
            Players
            <input type="number" min="{{ this.minPlayers }}" max="{{ this.maxPlayers }}" data-model="min_value({{ this.minPlayers }})|max_value({{ this.maxPlayers }})|game.playerCount" value="{{ game.playerCount }}" data-loading="addAttribute(disabled)">
        </label>

        {# The `disabled` here is business-conditional (single-region scenario), so the loading directive must stay
           behind the inverted condition — see the CLAUDE.md note on ux#372: an unconditional data-loading directive
           on an element that also carries a conditional `disabled` gets stripped on mount, silently re-enabling it. #}
        {% set isRegionDisabled = computed.regionChoices|length == 1 %}
        <label>
            Region
            <select data-model="game.region" {{ isRegionDisabled ? 'disabled' }} {% if not isRegionDisabled %}data-loading="addAttribute(disabled)"{% endif %}>
                {% for choice in computed.regionChoices %}
                    <option value="{{ choice.value }}" {{ (game.region ?? '') == choice.value ? 'selected' }}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            A.S.T. version
            <select data-model="game.astVersion" data-loading="addAttribute(disabled)">
                <option value="basic" {{ game.astVersion == 'basic' ? 'selected' }}>Basic</option>
                <option value="expert" {{ game.astVersion == 'expert' ? 'selected' }}>Expert</option>
            </select>
        </label>

        <ul class="game-creator__summary">
            {% for line in this.scenarioSummary %}
                <li>{{ line }}</li>
            {% endfor %}
        </ul>
    </fieldset>

    <section class="game-creator__players">
        <h2>Players</h2>

        <div class="game-creator__add-player">
            {# Same ux#372 trap as the region select above: `disabled` here is business-conditional
               (player limit reached), so data-loading must stay behind the inverted condition. #}
            {% set isNewPlayerNameDisabled = computed.isPlayerLimitReached %}
            <label>
                New player name
                <input type="text" data-model="norender|newPlayerName" value="{{ newPlayerName }}" {{ isNewPlayerNameDisabled ? 'disabled' }} {% if not isNewPlayerNameDisabled %}data-loading="addAttribute(disabled)"{% endif %}>
            </label>

            {% if _errors.has('newPlayerName') %}
                <p class="game-creator__field-error" data-error="newPlayerName" role="alert">{{ _errors.get('newPlayerName') }}</p>
            {% endif %}

            {% set isNewPlayerEmpireDisabled = computed.isPlayerLimitReached %}
            <label>
                Empire
                <select data-model="newPlayerEmpire" {{ isNewPlayerEmpireDisabled ? 'disabled' }} {% if not isNewPlayerEmpireDisabled %}data-loading="addAttribute(disabled)"{% endif %}>
                    <option value="" {{ newPlayerEmpire == '' ? 'selected' }}>— no empire —</option>
                    {% for empire in computed.availableEmpires %}
                        <option value="{{ empire }}" {{ newPlayerEmpire == empire ? 'selected' }}>{{ empire|capitalize }}</option>
                    {% else %}
                        <option value="" disabled>No empire available for the current settings.</option>
                    {% endfor %}
                </select>
            </label>

            {% set isAddPlayerDisabled = computed.isPlayerLimitReached %}
            <button
                type="button"
                {{ live_action('addPlayer') }}
                {{ isAddPlayerDisabled ? 'disabled' }}
                {% if not isAddPlayerDisabled %}data-loading="addAttribute(disabled)"{% endif %}
            >
                Add
            </button>
        </div>

        {% if computed.isPlayerLimitReached %}
            <p class="game-creator__hint">Player limit reached ({{ players|length }}/{{ game.playerCount }}).</p>
        {% endif %}

        <table>
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Empire</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for player in players %}
                    <tr{% if player.empire %} data-empire="{{ player.empire }}"{% endif %}>
                        <td>{{ player.name }}</td>
                        <td>
                            {# The fix for issue #19: while a request is in flight, every select in the component is disabled,
                               so a second row's assignment cannot start before the first round trip lands and re-renders
                               everyone's option list. No business-conditional `disabled` on this element, so the directive
                               is safe unconditional (contrast with the region/new-player controls above). #}
                            <select data-model="players.{{ loop.index0 }}.empire" {{ live_action('setEmpire', {index: loop.index0}, {}, 'change') }} data-loading="addAttribute(disabled)">
                                <option value="" {{ player.empire == '' ? 'selected' }}>— no empire —</option>
                                {% for choice in this.getEmpireChoicesFor(loop.index0) %}
                                    <option value="{{ choice.empire }}" {{ choice.taken ? 'disabled' }} {{ player.empire == choice.empire ? 'selected' }}>{{ choice.empire|capitalize }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            {% if player.empire == '' %}
                                <button
                                    type="button"
                                    class="game-creator__random-player"
                                    {{ live_action('assignRandomEmpire', {index: loop.index0}) }}
                                    data-loading="addAttribute(disabled)"
                                    aria-label="Assign a random empire"
                                    title="Assign a random empire"
                                >
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="3" y="3" width="18" height="18" rx="3" />
                                        <circle cx="8" cy="8" r="1" fill="currentColor" stroke="none" />
                                        <circle cx="16" cy="8" r="1" fill="currentColor" stroke="none" />
                                        <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
                                        <circle cx="8" cy="16" r="1" fill="currentColor" stroke="none" />
                                        <circle cx="16" cy="16" r="1" fill="currentColor" stroke="none" />
                                    </svg>
                                </button>
                            {% endif %}
                            <button
                                type="button"
                                class="game-creator__delete-player"
                                {{ live_action('removePlayer', {index: loop.index0}) }}
                                data-loading="addAttribute(disabled)"
                                aria-label="Delete player"
                                title="Delete player"
                            >
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6" />
                                    <path d="M10 11v6M14 11v6" />
                                </svg>
                            </button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">No players yet.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% set isRandomAllDisabled = not this.canAssignRandomEmpires %}
        <button
            type="button"
            class="game-creator__random-all"
            {{ live_action('assignRandomEmpires') }}
            {{ isRandomAllDisabled ? 'disabled' }}
            {% if not isRandomAllDisabled %}data-loading="addAttribute(disabled)"{% endif %}
        >
            RANDOM
        </button>
    </section>

    <fieldset class="game-creator__launch-block">
        <legend>Launch</legend>

        <label>
            Game name
            <input type="text" data-model="debounce(300)|game.slug" value="{{ game.slug }}" data-loading="addAttribute(disabled)">
            {% if this.isSlugAvailable %}
                <span class="game-creator__slug-status game-creator__slug-status--available" aria-label="Slug available">✓</span>
            {% else %}
                <span class="game-creator__slug-status game-creator__slug-status--taken" aria-label="Slug unavailable">✗</span>
            {% endif %}
        </label>

        {% if _errors.has('game.slug') %}
            <p class="game-creator__field-error" data-error="game.slug" role="alert">{{ _errors.get('game.slug') }}</p>
        {% endif %}

        {% if game.slug %}
            <p class="game-creator__slug-preview">{{ url('app_game_dashboard', {slug: game.slug}) }}</p>
        {% endif %}

        {% set isLaunchDisabled = not this.canLaunch %}
        <button
            type="button"
            class="game-creator__launch"
            {{ live_action('launch') }}
            {{ isLaunchDisabled ? 'disabled' }}
            {% if not isLaunchDisabled %}data-loading="addAttribute(disabled)"{% endif %}
        >
            Create the game
        </button>
    </fieldset>

    {% set issues = this.conformityIssues %}
    {% if issues is empty %}
        <p class="game-creator__conformity game-creator__conformity--ok" data-conformity="ok">Everything is fine.</p>
    {% else %}
        <p class="game-creator__conformity game-creator__conformity--error" data-conformity="error" role="alert">{{ issues|join(' ') }}</p>
    {% endif %}
</main>
