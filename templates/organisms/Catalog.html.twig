<section class="catalog panel">
    <twig:atoms:Label>Catalog</twig:atoms:Label>

    {% block controls %}{% endblock %}

    <div>
        {% for row in this.rows %}
            <twig:molecules:ProductTile
                :row="row"
                :locked="view.locked"
                :remainingBudget="view.remainingBudget"
                action="add"
            />
        {% endfor %}
    </div>
</section>
