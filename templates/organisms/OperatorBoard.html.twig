<main
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: operator_topic(game)})) }}
    class="operator-board"
>
    <section class="panel">
        <twig:atoms:Label>Game</twig:atoms:Label>

        {% if game.finished %}
            <span class="operator-board__finished-badge">Finished</span>
        {% else %}
            <div class="turn-row">
                <button class="button" type="button" {{ live_action('previousTurn') }} {{ game.currentTurn == 1 ? 'disabled' }}>
                    « Previous
                </button>
                <b>Turn {{ game.currentTurn }}</b>
                <button class="button" type="button" {{ live_action('nextTurn') }} data-loading="addAttribute(disabled)">
                    Next »
                </button>
            </div>

            <footer>
                <button class="button" type="button" {{ live_action('finishGame') }} data-loading="addAttribute(disabled)">
                    Finish game
                </button>
            </footer>
        {% endif %}
    </section>

    {% if not game.finished %}
        <twig:atoms:Hint>All players — tap a cell to edit</twig:atoms:Hint>

        <twig:molecules:ControlTable :players="game.players" :stats="this.trackedStats" />
    {% endif %}
</main>
