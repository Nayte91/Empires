<div {{ attributes }} class="player-orders">
    {% if error and not posOpen %}
        <p role="alert">{{ error }}</p>
    {% endif %}

    <section aria-label="Orders per turn">
        {% for card in this.cards %}
            <twig:molecules:orderCard
                :status="card.status"
                :turn="card.turn"
                :slugs="card.slugs"
                :total="card.total"
                :vp="card.vp"
            >
                {% if card.status == 'validated' %}
                    <button type="button" commandfor="erase-confirm-{{ player.id }}-{{ card.turn }}" command="show-modal">
                        Empty
                    </button>

                    <dialog id="erase-confirm-{{ player.id }}-{{ card.turn }}" class="modal" closedby="any">
                        <form method="dialog">
                            {% if card.turn == player.game.currentTurn %}
                                <p>Empty turn {{ card.turn }}?</p>
                            {% elseif card.turn + 1 == player.game.currentTurn %}
                                <p>Emptying turn {{ card.turn }} will also empty turn {{ card.turn + 1 }}.</p>
                            {% else %}
                                <p>
                                    Emptying turn {{ card.turn }} will also empty turns
                                    {{ card.turn + 1 }}…{{ player.game.currentTurn }}.
                                </p>
                            {% endif %}
                            <menu>
                                <li><button type="submit">Cancel</button></li>
                                <li>
                                    <button type="submit" {{ live_action('eraseOrder', {turn: card.turn}) }}>
                                        Confirm
                                    </button>
                                </li>
                            </menu>
                        </form>
                    </dialog>
                {% else %}
                    <button
                        type="button"
                        {{ live_action('openPos', {turn: card.turn}) }}
                        data-loading="addAttribute(disabled)"
                    >
                        Edit
                    </button>
                {% endif %}
            </twig:molecules:orderCard>
        {% endfor %}
    </section>

    {% if posOpen %}
        {% include 'organisms/posDialog.html.twig' %}
    {% endif %}
</div>
