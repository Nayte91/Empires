<div class="game-dashboard">
    {% set operatorUrl = this.operatorUrl %}
    {% set operatorQr = this.operatorQr %}

    <h1>{{ game.slug }}</h1>

    <p class="game-dashboard__operator-link">
        <twig:molecules:Modal class="game-dashboard__name-modal">
            <twig:block name="button">
                Operator board
            </twig:block>
            <twig:block name="content">
                <h2>Operator board</h2>
                {{ operatorQr|raw }}
                <p class="game-dashboard__qr-url"><a href="{{ operatorUrl }}">{{ operatorUrl }}</a></p>
                <button type="button" {{ stimulus_action('modal', 'close') }}>Close</button>
            </twig:block>
        </twig:molecules:Modal>
    </p>

    <h2>Scoreboard</h2>
    <twig:ScoreBoard :game="game" />

    <h2><a href="{{ path('app_game_ast', {slug: game.slug}) }}">A.S.T.</a></h2>
    <twig:Ast :game="game" />

    <h2><a href="{{ path('app_game_census', {slug: game.slug}) }}">Census</a></h2>
    <twig:CensusView :game="game" />
</div>
