<div
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id, events: ['order-validated', 'turn-changed', 'game-finished', 'player-updated']})) }}
    class="game-dashboard"
>
    {% set operatorUrl = this.operatorUrl %}
    {% set operatorQr = this.operatorQr %}

    <h1>Game — turn {{ game.currentTurn }}</h1>

    <p class="game-dashboard__operator-link">
        <twig:molecules:Modal class="game-dashboard__name-modal">
            <twig:block name="button">
                Operator board
            </twig:block>
            <twig:block name="content">
                <h2>Operator board</h2>
                {{ operatorQr|raw }}
                <p class="game-dashboard__qr-url"><a href="{{ operatorUrl }}">{{ operatorUrl }}</a></p>
                <button type="button" {{ stimulus_action('modal', 'close') }}>Close</button>
            </twig:block>
        </twig:molecules:Modal>
    </p>

    <table>
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Empire</th>
                <th scope="col">Advances</th>
                <th scope="col">Cities</th>
                <th scope="col">Census</th>
                <th scope="col">Treasury</th>
                <th scope="col">VP</th>
            </tr>
        </thead>
        <tbody>
            {% for player in game.players %}
                {% set playerUrl = this.getPlayerUrl(player) %}
                {% set playerQr = this.getPlayerQr(player) %}
                <tr>
                    <td>
                        <twig:molecules:Modal class="game-dashboard__name-modal">
                            <twig:block name="button">
                                {{ player.name }}
                            </twig:block>
                            <twig:block name="content">
                                <h2>{{ player.name }}</h2>
                                {{ playerQr|raw }}
                                <p class="game-dashboard__qr-url"><a href="{{ playerUrl }}">{{ playerUrl }}</a></p>
                                <button type="button" {{ stimulus_action('modal', 'close') }}>Close</button>
                            </twig:block>
                        </twig:molecules:Modal>
                    </td>
                    <td>{{ player.empire ?? '—' }}</td>
                    <td>{{ player.advances|join(', ') }}</td>
                    <td>{{ player.cities }}</td>
                    <td>{{ player.census }}</td>
                    <td>{{ player.treasury }}</td>
                    <td>{{ this.getPlayerVictoryPoints(player) }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">No players yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
