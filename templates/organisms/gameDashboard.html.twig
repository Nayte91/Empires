<div
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id, events: ['order-validated', 'turn-changed', 'game-finished', 'player-updated']})) }}
    class="game-dashboard"
>
    {% set operatorUrl = this.operatorUrl %}
    {% set operatorQr = this.operatorQr %}

    <h1>Game — turn {{ game.currentTurn }}</h1>

    <p class="game-dashboard__operator-link">
        <twig:molecules:Modal class="game-dashboard__name-modal">
            <twig:block name="button">
                Operator board
            </twig:block>
            <twig:block name="content">
                <h2>Operator board</h2>
                {{ operatorQr|raw }}
                <p class="game-dashboard__qr-url"><a href="{{ operatorUrl }}">{{ operatorUrl }}</a></p>
                <button type="button" {{ stimulus_action('modal', 'close') }}>Close</button>
            </twig:block>
        </twig:molecules:Modal>
    </p>

    <twig:Ast :game="game" />
    <twig:molecules:AstRequirements :eras="this.astEras" :astType="game.astType.value" />

    <twig:molecules:ScoreBoard :rows="this.playerRows" />
</div>
