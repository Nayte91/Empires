<main class="player-saga">
    <div class="hero">
        <div>
            {% set medal = this.medal %}
            <p><b{% if medal %} data-medal="{{ medal }}"{% endif %}>{{ this.rank }}<sup>{{ this.rankSuffix }}</sup></b> Final rank</p>
            <p><b>{{ this.score }}</b> Victory Points</p>
        </div>
    </div>

    <details class="standing panel" open>
        <summary class="label">Final position</summary>

        <twig:Ast :game="player.game" :player="player" />
    </details>

    <div class="panels">
        <details class="counters panel" open>
            <summary class="label">Final counters</summary>
            <dl>
                {% for counter in this.counters %}
                    <div data-stat="{{ counter.key }}">
                        <dt>{{ counter.label }}</dt>
                        <dd>{{ counter.value }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </details>

        <twig:Purchases :player="player" />
    </div>

    <section aria-label="Owned advances">
        {% set advancePoints = this.advancePoints %}
        <twig:atoms:SectionTitle>Advances ({{ advancePoints }} Victory Point{{ advancePoints == 1 ? '' : 's' }})</twig:atoms:SectionTitle>

        {% set sections = this.advanceSections %}

        {% if sections is empty %}
            <twig:atoms:Hint>No advance owned.</twig:atoms:Hint>
        {% else %}
            <div class="advances-grid">
                {% for section in sections %}
                    <twig:atoms:Hint>{{ section.turn is null ? 'Not bought in the shop' : 'Turn ' ~ section.turn }}</twig:atoms:Hint>

                    {% for advance in section.advances %}
                        <img id="product-{{ advance.key }}" src="{{ advance.fileName }}" alt="{{ advance.name }} card" loading="lazy">
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
    </section>
</main>
