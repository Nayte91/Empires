{% set title = player.name ~ '\'s shop' %}
{% set subtitle = 'Turn ' ~ player.game.currentTurn %}

<main
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ player.game.id, events: ['game-updated', 'order-updated']})) }}
    class="shop"
>
    <twig:atoms:PageTitle :title="title" :subtitle="subtitle" />

    {% if error %}
        <p class="shop__error" role="alert">{{ error }}</p>
    {% endif %}

    <twig:molecules:Discounts :player="player" />

    <div class="shop__layout">
        <twig:organisms:Catalog :player="player" :locked="this.isLockedForTurn" :storageKey="this.cartKey" />

        <aside class="shop__cart">
            <twig:Cart
                :player="player"
                :showLines="this.isCartVisible"
                :cartStamp="this.getCartStamp()"
                :locked="this.isLockedForTurn"
                checkoutLabel="Submit my order"
                :clearable="true"
                :storageKey="this.cartKey"
            />

            {% if this.isOrderVisible %}
                <div class="shop__order" data-status="{{ this.orderStatus }}">
                    <h3>Your order</h3>

                    <p class="shop__order-status" role="status">
                        {% if this.orderStatus == 'validated' %}
                            Order validated for this turn.
                        {% elseif this.orderStatus == 'rejected' %}
                            Order rejected for this turn — revise and resubmit.
                        {% else %}
                            Order pending for this turn.
                        {% endif %}
                    </p>

                    <ul class="shop__order-lines">
                        {% for row in this.orderLines %}
                            <li>
                                <span>{{ row.advance.name|capitalize }}</span>
                                {% if row.line.promotion and row.line.promotion.type.value != 'option' %}
                                    <small class="shop__cart-line-original">{{ row.line.netCost + row.line.promotion.amount }}</small>
                                {% endif %}
                                <span>{{ row.line.netCost }}</span>
                                {% if row.line.promotion and row.line.promotion.type.value != 'option' %}
                                    <span class="shop__cart-line-badge">−{{ row.line.promotion.amount }} {{ row.line.promotion.source }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>

                    <p class="shop__order-total">
                        {{ this.isLockedForTurn ? 'Total' : 'Indicative total' }}: {{ this.orderTotal }}
                    </p>

                    {% if not this.isLockedForTurn %}
                        <button
                            type="button"
                            {{ live_action('editPendingOrder') }}
                            data-loading="addAttribute(disabled)"
                        >
                            Modify
                        </button>
                    {% endif %}
                </div>
            {% endif %}
        </aside>
    </div>
</main>
