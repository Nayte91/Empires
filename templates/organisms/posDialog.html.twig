{# Point-of-sale dialog — private partial of organisms/playerOrders, shares its
   LiveComponent context (this, player, error, posTurn). Rendered `open` by the
   server, promoted to the top layer by the modal controller; Esc and outside
   clicks close it natively (closedby), and the close event syncs posOpen back. #}
<dialog
    open
    closedby="any"
    class="modal pos-dialog"
    aria-labelledby="pos-heading-{{ player.id }}"
    data-controller="modal"
    data-action="close->live#action"
    data-live-action-param="closePos"
>
    <h2 id="pos-heading-{{ player.id }}">Order — {{ player.name }} — Turn {{ posTurn }}</h2>

    {% if error %}
        <p role="alert">{{ error }}</p>
    {% endif %}

    <twig:molecules:Discounts :player="player" />

    {% set posOrder = this.posOrder %}
    {% if posOrder and posOrder.status.value == 'validated' %}
        <p role="status">Order validated.</p>

        <button type="button" {{ live_action('closePos') }} data-loading="addAttribute(disabled)">
            Close
        </button>
    {% else %}
        <twig:organisms:ProductGrid :player="player" :compact="true" storageKey="pos.{{ player.id }}" />

        <twig:Cart :player="player" :cartStamp="this.getCartStamp()" storageKey="pos.{{ player.id }}" />

        <button
            type="button"
            {{ live_action('checkout') }}
            {{ (this.isTicketEmpty or this.hasIncompleteAllocations) ? 'disabled' }}
        >
            Confirm purchase
        </button>
    {% endif %}
</dialog>
