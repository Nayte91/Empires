<main
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: shop_topic(player)})) }}
    class="shop"
>
    {% if error %}
        <p class="shop__error" role="alert">{{ error }}</p>
    {% endif %}

    <twig:molecules:Discounts :player="player" :open="true" />

    <p class="shop__pictures-toggle">
        <label>
            <input type="checkbox" id="display-pictures">
            Show pictures
        </label>
    </p>

    <p class="shop__budget">
        <label>
            Budget
            <input type="number" id="shop-budget" min="0" data-model="budget" value="{{ budget }}">
        </label>
        <output for="shop-budget">{{ budget is null ? '' : 'Remaining: ' ~ max(0, this.remainingBudget) }}</output>
    </p>

    <div class="shop__layout">
        <twig:organisms:Catalog :player="player" :storageKey="this.cartKey" :view="this.catalogView" />

        <aside class="shop__cart">
            {% if this.isOrderVisible %}
                {% set orderHint = this.orderHint %}

                <section class="cart panel" data-status="{{ this.orderStatusHook }}">
                    <twig:atoms:Label>Cart</twig:atoms:Label>
                    <twig:atoms:Hint>{{ orderHint }}</twig:atoms:Hint>

                    <ul class="lines">
                        {% for row in this.orderLines %}
                            <twig:molecules:TicketLine :row="row" />
                        {% endfor %}
                    </ul>

                    <p class="total">
                        {{ this.isLockedForTurn ? 'Total' : 'Indicative total' }}: {{ this.orderTotal }}
                    </p>

                    {% if not this.isLockedForTurn %}
                        <footer>
                            <button
                                class="button"
                                type="button"
                                {{ live_action('editPendingOrder') }}
                                data-loading="addAttribute(disabled)"
                            >
                                Modify
                            </button>
                        </footer>
                    {% endif %}
                </section>
            {% else %}
                <twig:Cart
                    :player="player"
                    :cartStamp="this.getCartStamp()"
                    :locked="this.isLockedForTurn"
                    checkoutLabel="Submit my order"
                    :clearable="true"
                    :storageKey="this.cartKey"
                    :hint="this.orderHint"
                    :status="this.orderStatusHook"
                />
            {% endif %}
        </aside>
    </div>
</main>
