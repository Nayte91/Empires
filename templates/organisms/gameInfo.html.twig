<form
    {{ attributes }}
    data-color="{{ this.settings.civilizationColor ? this.settings.civilizationColor : '#aaa' }}"
    class="game-info"
>
    <fieldset>
        <legend>Game settings</legend>

        <label>
            <span>Players</span>
            <input
                type="number"
                min="3"
                max="18"
                data-model="debounce(1000)|settings.playerCount"
                value="{{ this.settings.playerCount }}"
            />
        </label>

        <label>
            <span>Region</span>
            <select data-model="settings.region" {{ this.settings.playerCount > 9 ? 'disabled' }}>
                {% for region in this.regions %}
                    <option value="{{ region.name }}">{{ region.name|capitalize }}</option>
                {% else %}
                    <option value>Global</option>
                {% endfor %}
            </select>
        </label>

        <label>
            <span>A.S.T. Type</span>
            <select data-model="settings.astType">
                <option value="basic">Basic</option>
                <option value="expert">Expert</option>
            </select>
        </label>
    </fieldset>

    <fieldset class="player-info">
        <legend>Player Information</legend>

        <label>
            <span>Name</span>
            <input
                type="text"
                data-model="debounce(1000)|settings.playerName"
                value="{{ this.settings.playerName }}"
            />
        </label>

        <label>
            <span>Civilization</span>
            <select data-model="settings.civilizationPosition">
                <option value="0">-- Choose a tribe --</option>
                {% for civilization in this.civilizations %}
                    <option value="{{ civilization.position }}" {{ civilization.name == this.settings.civilizationName ? 'selected' }}>{{ civilization.name|capitalize }}</option>
                {% endfor %}
            </select>
        </label>
    </fieldset>

    <fieldset>
        <legend>Game flow</legend>

        <label>
            <span>Turn</span>
            <input
                type="number"
                min="1"
                max="20"
                data-model="debounce(1000)|settings.currentTurn"
                value="{{ this.settings.currentTurn }}"
            />
        </label>

        <label>
            Clear information
            {{ include('atoms/deleteSessionButton.html.twig') }}
        </label>
    </fieldset>
</form>
