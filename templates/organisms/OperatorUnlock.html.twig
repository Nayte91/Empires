<main {{ attributes }} class="operator-unlock">
    <div class="panel">
        <twig:atoms:Label>Operator</twig:atoms:Label>

        <input type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" autofocus data-model="pin" value="{{ pin }}">

        {% if error %}
            <p role="alert" data-error="pin">{{ error }}</p>
        {% endif %}

        <button class="button" type="button" {{ live_action('unlock') }} data-loading="addAttribute(disabled)">Unlock</button>
    </div>
</main>
