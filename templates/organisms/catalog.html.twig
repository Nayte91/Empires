<section class="catalog">
    <h2>Catalog</h2>

    {% for row in this.rows %}
        {% if compact %}
            {% include 'molecules/productTile.html.twig' with {row, action: 'add'} only %}
        {% else %}
            {% include 'molecules/productCard.html.twig' with {row, locked, action: 'add'} only %}
        {% endif %}
    {% endfor %}
</section>
