{% extends 'layout.html.twig' %}

{% block title %}Empires - {{ player.name }}'s board{% endblock %}

{% block body_attr %}data-empire="{{ player.empire }}"{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('styles/skeletons/player/board.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/discounts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/statPicker.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/controlBoard.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/outlook.css') }}">
{% endblock %}

{% block main %}
    {{ component('PlayerBoard', {player}) }}
{% endblock %}
