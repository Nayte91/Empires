{% extends 'layout.html.twig' %}

{% block title %}Empires - {{ player.name }}'s shop{% endblock %}

{% block body_attr %}{% if player.empire %}style="background-color: var(--empire-{{ player.empire }}, dimgray)"{% endif %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/shop.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/productCard.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/discounts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/modal.css') }}">
{% endblock %}

{% block body %}
    {{ component('Shop', {player}) }}
{% endblock %}
