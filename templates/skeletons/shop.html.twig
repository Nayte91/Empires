{% extends 'base.html.twig' %}

{% block title %}Empires - {{ player.name }}'s shop{% endblock %}

{% block body_attr %}{% if empireColor %}style="background-color: {{ empireColor }}"{% endif %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/operator.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/shop.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/discounts.css') }}">
{% endblock %}

{% block body %}
    {{ component('Shop', {player}) }}
{% endblock %}
