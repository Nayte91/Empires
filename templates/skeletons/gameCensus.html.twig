{% extends 'layout.html.twig' %}

{% set title = 'Census' %}
{% set subtitle = game.slug %}

{% block title %}{{ title }} - {{ subtitle }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/molecules/census.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/skeletons/gameCensus.css') }}">
{% endblock %}

{% block main %}
    <main>
        <twig:atoms:PageTitle :title="title" :subtitle="subtitle" />
        <twig:Census :game="game" />
    </main>
{% endblock %}
