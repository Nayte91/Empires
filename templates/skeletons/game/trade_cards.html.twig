{% extends 'layout.html.twig' %}

{% block title %}Empires - Trade cards{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/molecules/tradeCards.css') }}" data-turbo-track="dynamic">
{% endblock %}

{% block header %}
    <twig:atoms:PageTitle :heading="game.slug" :qualifier="'Turn ' ~ game.currentTurn" />
{% endblock %}

{% block main %}
    <main>
        <twig:atoms:SectionTitle>Trade card distribution</twig:atoms:SectionTitle>
        {% include 'molecules/trade_cards.html.twig' with {distribution} only %}
    </main>
{% endblock %}
