{% extends 'layout.html.twig' %}

{% block title %}Empires - Operator console{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('styles/atoms/tab.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/statPicker.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/orderCard.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/controlBoard.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/organisms/playerOrders.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/organisms/operatorConsole.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/skeletons/game/operator.css') }}" data-turbo-track="dynamic">
{% endblock %}

{% block header %}
    <twig:molecules:GameHeading :game="game" />
{% endblock %}

{% block main %}
    {{ component('OperatorConsole', {game}) }}
{% endblock %}
