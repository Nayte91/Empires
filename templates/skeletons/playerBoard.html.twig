{% extends 'layout.html.twig' %}

{% block title %}Empires - {{ player.name }}'s board{% endblock %}

{% block body_attr %}{% if player.empire %}style="background-color: var(--empire-{{ player.empire }}, dimgray)"{% endif %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/playerBoard.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/discounts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/statPicker.css') }}">
{% endblock %}

{% block main %}
    {{ component('PlayerBoard', {player}) }}
{% endblock %}
