{% extends 'layout.html.twig' %}

{% set title = 'Archaeological Succession Timeline' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/atoms/marker.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/ast.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/molecules/astRequirements.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/skeletons/gameAst.css') }}">
{% endblock %}

{% block main %}
    <main>
        <twig:atoms:PageTitle :title="title" />
        <twig:Ast :game="game" />
        <twig:molecules:AstRequirements :eras="eras" :astVersion="game.astVersion.value" />
    </main>
{% endblock %}
