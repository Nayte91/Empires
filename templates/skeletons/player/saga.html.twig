{% extends 'layout.html.twig' %}

{% block title %}Empires - {{ player.name }}'s saga{% endblock %}

{% block body_attr %}data-empire="{{ player.empire }}"{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('styles/atoms/marker.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/skeletons/player/saga.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/ast.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/purchaseValue.css') }}" data-turbo-track="dynamic">
{% endblock %}

{% block header %}
    <twig:atoms:PageTitle variant="celebration" :heading="player.name" :qualifier="player.empire|capitalize" />
{% endblock %}

{% block main %}
    {{ component('PlayerSaga', {player}) }}
{% endblock %}
