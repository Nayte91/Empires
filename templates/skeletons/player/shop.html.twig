{% extends 'layout.html.twig' %}

{% block title %}Empires - {{ player.name }}'s shop{% endblock %}

{% block body_attr %}data-empire="{{ player.empire }}"{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/skeletons/player/shop.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/productTile.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/discounts.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/organisms/catalog.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/organisms/cart.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/giftPicker.css') }}" data-turbo-track="dynamic">
    <link rel="stylesheet" href="{{ asset('styles/molecules/allocationPicker.css') }}" data-turbo-track="dynamic">
{% endblock %}

{% block header %}
    <twig:molecules:PlayerHeading :player="player" />
{% endblock %}

{% block main %}
    {{ component('Shop', {player}) }}
{% endblock %}
