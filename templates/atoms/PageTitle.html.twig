{% props heading, qualifier = null, variant = 'page', back = null, backHref = null, renameFor = null %}

<header id="page-title" data-title="{{ variant }}">
    {% if back is not null %}
        <a href="{{ backHref }}" class="button">{{ back }}</a>
    {% endif %}

    <hgroup>
        <h1>{{ heading }}</h1>
        {% if qualifier is not null %}
            <p>{{ qualifier }}</p>
        {% endif %}
    </hgroup>

    {% if renameFor is not null %}
        <button class="button" type="button" commandfor="{{ renameFor }}" command="show-modal">Rename</button>
    {% endif %}
</header>
