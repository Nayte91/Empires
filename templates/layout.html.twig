<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="robots" content="index, follow">
        <meta name="referrer" content="strict-origin-when-cross-origin">
        <link rel="canonical" href="{% block canonical %}{{ app.request.schemeAndHttpHost }}{{ app.request.requestUri }}{% endblock %}">

        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="icon" href="{{ asset('images/favicon.avif') }}" type="image/avif">

        {{ component('ThemeColors') }}

        {{ turbo_exempts_page_from_cache() }}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/globals.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/molecules/modal.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/molecules/panel.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/atoms/button.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/atoms/touchButton.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/atoms/pageTitle.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/atoms/sectionTitle.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/atoms/label.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/atoms/hint.css') }}" data-turbo-track="reload">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app', {'data-turbo-track': 'reload'}) }}{% endblock %}
        {% endblock %}
    </head>
    <body {% block body_attr %}{% endblock %}>
        <header></header>
        {% block main %}{% endblock %}
        <footer></footer>
    </body>
</html>
