{# Allocation picker molecule — shown under a cart/ticket line whose advance grants a
   promotion.option (a fixed pool of credits the player must split across the 5
   facets, by steps of 5, before the order can be submitted/checked out).
   Component-agnostic: allocateAction lets Shop (cart) and PlayerOrders (POS ticket)
   each drive their own live action. Expected context: row, allocateAction, remaining,
   allocation (every facet, 0-defaulted). #}
<div class="allocation-picker">
    <p class="allocation-picker__remaining">Remaining: {{ remaining }}</p>
    <ul class="allocation-picker__rows">
        {% for facet, current in allocation %}
            <li class="allocation-picker__row" data-advance-category="{{ facet }}">
                <span class="allocation-picker__category">{{ facet|capitalize }}</span>
                {% set isMinusDisabled = current <= 0 %}
                {% set isPlusDisabled = remaining <= 0 %}
                <button
                    type="button"
                    {{ live_action(allocateAction, {for: row.advance.key, facet: facet, delta: -row.advance.promotion.option.step}) }}
                    {{ isMinusDisabled ? 'disabled' }}
                    {% if not isMinusDisabled %}data-loading="addAttribute(disabled)"{% endif %}
                    class="allocation-picker__step allocation-picker__step--minus"
                    title="Remove {{ row.advance.promotion.option.step }} from {{ facet }}"
                >
                    −
                </button>
                <span class="allocation-picker__value">{{ current }}</span>
                <button
                    type="button"
                    {{ live_action(allocateAction, {for: row.advance.key, facet: facet, delta: row.advance.promotion.option.step}) }}
                    {{ isPlusDisabled ? 'disabled' }}
                    {% if not isPlusDisabled %}data-loading="addAttribute(disabled)"{% endif %}
                    class="allocation-picker__step allocation-picker__step--plus"
                    title="Add {{ row.advance.promotion.option.step }} to {{ facet }}"
                >
                    +
                </button>
            </li>
        {% endfor %}
    </ul>
</div>
