{# Shown under a cart line whose advance grants a promotion.option: a fixed credit pool the player must fully allocate across the facets (by promotion.option.step increments) before checkout is allowed. Expected context: row, allocateAction, remaining, allocation (every facet, 0-defaulted). #}
<div class="allocation-picker">
    <p class="remaining">Remaining: {{ remaining }}</p>
    <ul class="rows">
        {% for facet, current in allocation %}
            <li class="row" data-advance-category="{{ facet }}">
                <span class="category">{{ facet|capitalize }}</span>
                {% set isMinusDisabled = current <= 0 %}
                {% set isPlusDisabled = remaining <= 0 %}
                <button
                    type="button"
                    {{ live_action(allocateAction, {for: row.advance.key, facet: facet, delta: -row.advance.promotion.option.step}) }}
                    {{ isMinusDisabled ? 'disabled' }}
                    {% if not isMinusDisabled %}data-loading="addAttribute(disabled)"{% endif %}
                    class="step touch-button"
                    title="Remove {{ row.advance.promotion.option.step }} from {{ facet }}"
                >
                    −
                </button>
                <span class="value">{{ current }}</span>
                <button
                    type="button"
                    {{ live_action(allocateAction, {for: row.advance.key, facet: facet, delta: row.advance.promotion.option.step}) }}
                    {{ isPlusDisabled ? 'disabled' }}
                    {% if not isPlusDisabled %}data-loading="addAttribute(disabled)"{% endif %}
                    class="step touch-button"
                    title="Add {{ row.advance.promotion.option.step }} to {{ facet }}"
                >
                    +
                </button>
            </li>
        {% endfor %}
    </ul>
</div>
