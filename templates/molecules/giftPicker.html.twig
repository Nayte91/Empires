{# Expected context: row, chooseAction, revokeAction, candidates, chosenGift. #}
{% if chosenGift %}
    <p class="gift-picker chosen">
        Free gift: {{ chosenGift.name|capitalize }}
        <button
            type="button"
            {{ live_action(revokeAction, {for: row.advance.key}) }}
            data-loading="addAttribute(disabled)"
            class="revoke"
        >
            Change gift
        </button>
    </p>
{% elseif candidates is not empty %}
    <div class="gift-picker">
        {% for facet, threshold in row.advance.promotion.gift %}
            <p class="intro">
                {{ row.advance.name|capitalize }} offers a free {{ facet }} advance (base cost below {{ threshold }}).
            </p>
        {% endfor %}
        <ul class="candidates">
            {% for candidate in candidates %}
                <li>
                    <button
                        type="button"
                        {{ live_action(chooseAction, {for: row.advance.key, key: candidate.key}) }}
                        data-loading="addAttribute(disabled)"
                        class="candidate"
                    >
                        {{ candidate.name|capitalize }}
                        <small class="cost">{{ candidate.cost }}</small>
                    </button>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
