<details {{ attributes }} class="discounts panel">
    <summary>Discounts</summary>

    <table>
        <thead>
            <tr>
                <th scope="col">Category</th>
                <th scope="col">Credit</th>
            </tr>
        </thead>
        <tbody>
            {% for category, credit in this.credits.facets %}
                <tr data-advance-category="{{ category }}" data-discount-state="{{ credit.amount == 0 ? 'empty' : (credit.spent ? 'spent' : 'live') }}">
                    <td>{{ category|capitalize }}</td>
                    <td><b>{{ credit.amount }}</b></td>
                </tr>
            {% endfor %}
            {% for name, credit in this.credits.named %}
                <tr data-discount-state="{{ credit.amount == 0 ? 'empty' : (credit.spent ? 'spent' : 'live') }}">
                    <td>{{ name|replace({'_': ' '})|capitalize }}</td>
                    <td><b>{{ credit.amount }}</b></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</details>
