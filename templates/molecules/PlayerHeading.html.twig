<div {{ attributes.defaults({class: 'player-heading'}) }}>
    <twig:atoms:PageTitle variant="player" :heading="player.name" :qualifier="player.empire|capitalize ~ ' · Turn ' ~ player.game.currentTurn" :renameFor="'rename-player-' ~ player.id" />

    {% if _errors.has('newName') %}
        <p data-error="newName" role="alert">{{ _errors.get('newName') }}</p>
    {% endif %}

    <dialog id="rename-player-{{ player.id }}" class="modal" closedby="any">
        <form method="dialog">
            <h2>Rename {{ player.name }}</h2>

            <label>
                Name
                <input type="text" data-model="norender|newName" value="{{ newName }}" maxlength="50">
            </label>

            <menu>
                <li><button type="submit">Cancel</button></li>
                <li><button type="submit" {{ live_action('rename') }}>Confirm</button></li>
            </menu>
        </form>
    </dialog>
</div>
