<div {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: shop_topic(player)})) }}>
    <twig:atoms:PageTitle variant="player" :heading="player.name" :qualifier="player.empire|capitalize ~ ' · Turn ' ~ player.game.currentTurn" :renameFor="'rename-player-' ~ player.id" />

    {% if _errors.has('newName') %}
        <p data-error="newName" role="alert">{{ _errors.get('newName') }}</p>
    {% endif %}

    <twig:molecules:Modal :id="'rename-player-' ~ player.id">
        <form method="dialog">
            <h2>Rename {{ player.name }}</h2>

            <label>
                Name
                <input type="text" data-model="norender|newName" value="{{ newName }}" maxlength="{{ constant('App\\State\\Player::MAX_NAME_LENGTH') }}">
            </label>

            <menu>
                {# A `method="dialog"` form's implicit submission (Enter in the field) fires its FIRST
                   submit button, so Cancel must close through the invoker command, never as a submit. #}
                <li><button class="button" type="button" command="close" commandfor="rename-player-{{ player.id }}">Cancel</button></li>
                <li><button class="button" type="submit" {{ live_action('rename') }}>Confirm</button></li>
            </menu>
        </form>
    </twig:molecules:Modal>
</div>
