<section
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id, events: ['player-updated', 'game-updated']})) }}
    class="census"
>
    {% if this.orderedPlayers is not empty %}
        <ol class="census__order">
            {% for player in this.orderedPlayers %}
                <li data-empire="{{ player.empire }}">
                    <b>{{ player.empire }}</b> ({{ player.name }}) — {{ player.census }} pop, {{ player.cities }} cities
                    {% if this.isMilitary(player) %}<small title="Military">⚔</small>{% endif %}
                </li>
            {% endfor %}
        </ol>
    {% else %}
        <p>No players yet.</p>
    {% endif %}
</section>
