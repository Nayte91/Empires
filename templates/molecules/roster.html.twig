<table
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id, events: ['player-updated', 'game-updated']})) }}
    class="roster"
>
    <caption id="roster">Turn {{ game.currentTurn }}</caption>
    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">Treasury</th>
            <th scope="col">Census</th>
            <th scope="col">Cities</th>
            <th scope="col">Cards</th>
            <th scope="col">Techs</th>
        </tr>
    </thead>
    <tbody>
        {% for row in this.playerRows %}
            {% set player = row.player %}
            <tr data-empire="{{ player.empire }}">
                <th scope="row" data-empire>
                    <b>{{ player.empire|empire_adjective }}</b>
                    <small data-player>({{ player.name }})</small>
                    {% if row.military %}<small title="Military">⚔</small>{% endif %}
                </th>
                <td>{{ player.treasury }}</td>
                <td>{{ player.census }}</td>
                <td>{{ player.cities }}</td>
                <td>{{ player.cards }}</td>
                <td>{{ player.advances|length }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
