<table
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id, events: ['player-updated', 'game-updated']})) }}
    class="roster"
>
    <caption id="roster">Turn {{ game.currentTurn }} — Census order</caption>
    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">Treasury</th>
            <th scope="col">Population</th>
            <th scope="col">Cities</th>
            <th scope="col">Advances</th>
        </tr>
    </thead>
    <tbody>
        {% for row in this.playerRows %}
            {% set player = row.player %}
            <tr data-empire="{{ player.empire }}">
                <th scope="row" data-empire>
                    <span data-rank>{{ row.rank }}.</span>
                    <b>{{ player.empire|empire_adjective }}</b>
                    <small data-player>({{ player.name }})</small>
                    {% if row.military %}<small data-military title="Military">⚔</small>{% endif %}
                </th>
                <td data-label="Treasury">{{ player.treasury }}</td>
                <td data-label="Population">{{ player.census }}</td>
                <td data-label="Cities">{{ player.cities }}</td>
                <td data-label="Advances">{{ player.advances|length }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
