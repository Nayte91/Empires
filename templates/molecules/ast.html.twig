<table
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id, events: ['player-updated', 'game-updated']})) }}
    class="ast"
>
    <caption>{{ game.astVersion.value|capitalize }} version</caption>
    <colgroup>
        <col>
        {% for position in range(0, this.trackLength - 1) %}
            <col>
        {% endfor %}
    </colgroup>
    <thead>
        <tr>
            <th scope="col"></th>
            {% for entry in this.eraHeaders %}
                <th scope="col" colspan="{{ entry.span }}" class="{{ loop.index0 is odd ? 'alt' : '' }}">{{ entry.era.name }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for player in this.rankedPlayers %}
            {% set columnEras = this.columnErasFor(player) %}
            <tr data-empire="{{ player.empire }}">
                <th scope="row"><b>{{ player.empire|capitalize }}</b> ({{ player.name }})</th>
                {% for position in range(0, this.trackLength - 1) %}
                    <td class="{{ columnEras[position].index is odd ? 'alt' : '' }}"{{ position == game.currentTurn - 1 ? ' data-current-turn' : '' }}>
                        {%- if position == 0 -%}
                            <twig:atoms:Marker :pos="player.astPosition" empire="{{ player.empire }}" title="{{ player.name }} — {{ this.eraNameFor(player) }}" />
                        {%- endif -%}
                        {%- if columnEras[position].key == 'start' -%}→{%- endif -%}
                    </td>
                {% endfor %}
            </tr>
        {% else %}
            <tr><td colspan="{{ this.trackLength + 1 }}">No players yet.</td></tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <th scope="row">Victory Points</th>
            {% for position in range(0, this.trackLength - 1) %}
                <td{{ position == game.currentTurn - 1 ? ' data-current-turn' : '' }}>{{ constant('App\\Game\\Service\\ScoreCalculator::POINTS_PER_AST_POSITION') * position }}</td>
            {% endfor %}
        </tr>
    </tfoot>
</table>
