<div id="evolution" class="evolution" data-controller="evolution" data-action="chartjs:connect->evolution#onChartConnect">
    <div class="plot">
        {{ render_chart(this.chart) }}
    </div>
    <ul id="evolution-legend">
        {% for player in this.players %}
            <li>
                <button
    class="button" type="button" data-action="evolution#toggle" data-evolution-index-param="{{ loop.index0 }}">
                    <twig:atoms:PlayerIdentity :empire="player.empire" :name="player.name" />
                </button>
            </li>
        {% endfor %}
    </ul>
</div>
