{% props status, turn, slugs, total, vp, rejectable %}
<article class="order-card" data-status="{{ status }}">
    <h4>Turn {{ turn }}</h4>

    <p>{{ slugs is empty
        ? 'Empty'
        : slugs|map(slug => slug|replace({'_': ' '})|capitalize)|join(', ') }}
    </p>

    <div>
        <p><strong>Total: {{ total }}</strong></p>

        <p><small>VP: {{ vp }}</small></p>
    </div>

    {% block content %}{% endblock %}
</article>
