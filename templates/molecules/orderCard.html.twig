{% props status, turn, slugs, total, vp %}
<article class="order-card" data-status="{{ status }}">
    <h4>Turn {{ turn }}</h4>

    <p>{{ slugs is empty
        ? 'Empty'
        : slugs|map(slug => slug|replace({'_': ' '})|capitalize)|join(', ') }}
    </p>

    <p><strong>Total: {{ total }}</strong></p>

    <small>VP: {{ vp }}</small>

    {% block content %}{% endblock %}
</article>
