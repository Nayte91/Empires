<section {{ attributes }} class="control-board">
    <div class="controls" aria-label="Controls">
        {% for stat in stats %}
            <twig:molecules:StatPicker :player="player" :stat="stat" :value="attribute(player, stat)" />
        {% endfor %}

        {% if withShopLink %}<a href="{{ this.shopUrl }}" class="shop-link">Shop</a>{% endif %}
    </div>
</section>
