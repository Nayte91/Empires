<section {{ attributes }} class="control-board">
    <div class="controls" aria-label="Controls">
        {% for stat in stats %}
            <twig:molecules:StatPicker :player="player" :stat="stat" />
        {% endfor %}
    </div>

{% if this.advisories is not empty %}
    <ul class="advisories" role="alert">
        {% for advisory in this.advisories %}
            <li>⚠ {{ advisory.message }}</li>
        {% endfor %}
    </ul>
{% endif %}
</section>
