{% set dialogId = 'stat-picker-' ~ stat.value ~ '-' ~ player.id %}
{# Inside a component's slot `this` is rebound to that component — here the Modal — while ordinary
   variables pass through untouched. Hence the alias: it is this picker the slot needs to read. #}
{% set picker = this %}
<div {{ attributes }}>
    <button class="button" type="button" commandfor="{{ dialogId }}" command="show-modal">{% if caption %}<span>{{ stat.label }}</span> {% endif %}<b>{{ stat.format(value) }}</b></button>
    <twig:molecules:Modal :id="dialogId" class="stat-picker__dialog">
        <form method="dialog">
            <h2>{{ stat.label }} — {{ player.name }}</h2>

            <section>
                {% if picker.actions is not empty %}
                    <menu>
                        {% for action in picker.actions %}
                            {% set isDisabled = not picker.isAvailable(action) %}
                            <li>
                                <button class="button" type="submit" data-action="live#action"
                                        data-live-action-param="run" data-live-name-param="{{ action.value }}"
                                        data-value="{{ action.value }}" {{ isDisabled ? 'disabled' }}>
                                    {{ action.label }}
                                </button>
                            </li>
                        {% endfor %}
                    </menu>
                {% endif %}

                <fieldset>
                    {% set ceiling = picker.ceiling %}
                    {% for n in picker.floor..picker.displayCeiling %}
                        <button class="button" type="submit" data-action="live#action" data-live-action-param="pick"
                                data-live-value-param="{{ n }}" data-value="{{ n }}"
                                {{ value == n ? 'data-selected autofocus' }} {{ n > ceiling ? 'disabled' }}>
                            {{ stat.format(n) }}
                        </button>
                    {% endfor %}
                </fieldset>
            </section>
        </form>
    </twig:molecules:Modal>
</div>
