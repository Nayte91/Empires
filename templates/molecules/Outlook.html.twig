<details class="outlook panel" open>
    <summary class="label">Outlook</summary>

    <ul role="status">
        {% for advisory in this.advisories %}
            <li
                data-level="{{ advisory.level.value }}"
                {% if advisory.advance %}data-advance="{{ advisory.advance }}" title="{{ advisory.advance|capitalize }}"{% endif %}
            >{{ advisory.message }}</li>
        {% endfor %}
    </ul>
</details>
