{% props tabs, active %}

<footer>
    <menu class="section-switcher">
        {% for tab in tabs %}
            <li>
                {% if tab.href is defined %}
                    <a href="{{ tab.href }}"{% if tab.value == active %} aria-current="page"{% endif %}>
                        <twig:ux:icon :name="tab.icon" />
                        {{ tab.label }}
                    </a>
                {% else %}
                    <input type="radio" name="tab" id="tab-{{ tab.value }}" value="{{ tab.value }}" {{ tab.value == active ? 'checked' }} hidden>
                    <label for="tab-{{ tab.value }}">
                        <twig:ux:icon :name="tab.icon" />
                        {{ tab.label }}
                    </label>
                {% endif %}
            </li>
        {% endfor %}
    </menu>
</footer>
