{% set cat1 = row.advance.facets[0] %}
{% set cat2 = row.advance.facets[1] ?? cat1 %}
<article
    id="product-{{ row.advance.key }}"
    class="product-card{{ row.product.owned ? ' product-card--owned' }}{{ row.product.inCart ? ' product-card--in-cart' }}"
    style="--cat-1: var(--advance-{{ cat1 }}); --cat-2: var(--advance-{{ cat2 }})"
    {{ row.product.owned ? 'data-owned' }}
    {{ row.product.inCart ? 'data-in-cart' }}
>
    {% if row.advance.fileName %}
        <header>
            <img src="{{ row.advance.fileName }}" alt="{{ row.advance.name }} card" loading="lazy">
        </header>
    {% endif %}

    <main>
        <h3>{{ row.advance.name|capitalize }}</h3>

        <div class="product-card__price">
            {% if row.product.netCost < row.advance.cost %}
                <small class="product-card__price-original">{{ row.advance.cost }}</small>
            {% endif %}
            <b data-price-net>{{ row.product.netCost }}</b>
        </div>
    </main>

    {% if not readonly|default(false) %}
        <button
            type="button"
            {{ live_action(action|default('addToCart'), {key: row.advance.key}) }}
            {{ (row.product.owned or row.product.inCart or locked) ? 'disabled' }}
            data-loading="addAttribute(disabled)"
            class="product-card__add"
        >
            <span class="sr-only">Add {{ row.advance.name|capitalize }}</span>
        </button>
    {% endif %}
</article>
