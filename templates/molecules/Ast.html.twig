{% set openingSpan = this.openingSpan %}
<table {{ attributes.defaults({'data-region': 'ast'}) }} class="ast">
    <caption id="ast"{{ game.finished ? ' data-finished' }}>{{ game.astVersion.value|capitalize }} version — Turn {{ game.currentTurn }}{{ game.finished ? ' — finished' }}</caption>
    <thead>
        <tr>
            <th scope="col"></th>
            {% for entry in this.eraHeaders %}
                <th scope="col" colspan="{{ entry.span }}"{{ loop.index0 is odd ? ' data-band' : '' }}>{{ entry.era.name }}</th>
            {% endfor %}
            <th scope="col">Score</th>
        </tr>
    </thead>
    <tbody>
        {% for player in this.rankedPlayers %}
            {% set columnEras = this.columnErasFor(player) %}
            {% set medal = this.medalOf(player) %}
            <tr data-empire="{{ player.empire }}">
                <th scope="row"><b>{{ player.empire|capitalize }}</b> <small>({{ player.name }})</small></th>
                {% for position in range(0, this.trackLength - 1) %}
                    <td
                        {{- columnEras[position].index is odd ? ' data-band' : '' }}
                        {{- position < openingSpan ? ' data-opening' : '' }}
                        {{- position == openingSpan ? ' data-anchor' : '' }}
                        {{- position == game.currentTurn - 1 ? ' data-current-turn' : '' }}>
                        {#- One marker per row, parked on the anchor column whatever the player's
                            position: it is the same element from turn to turn, which is the only
                            way the move can be animated rather than jump. The offset counts in
                            --ast-cell-size, the variable the cells are sized from, so the pitch
                            cannot drift from them. Inside the opening stretch the offset is
                            negative; the compact board drops those columns and the stylesheet
                            parks the marker back on the anchor rather than outside the table. -#}
                        {%- if position == openingSpan -%}
                            <twig:atoms:Marker
                                empire="{{ player.empire }}"
                                title="{{ player.name }} — {{ this.eraNameFor(player) }}"
                                :position="player.astPosition - openingSpan"
                                id="ast-marker-{{ player.id }}" />
                        {%- endif -%}
                        {%- if columnEras[position].key == 'start' -%}→{%- endif -%}
                    </td>
                {% endfor %}
                <td data-score{% if medal %} data-medal="{{ medal }}"{% endif %}>{{ this.scoreOf(player) }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <th scope="row">Victory Points</th>
            {% for position in range(0, this.trackLength - 1) %}
                <td{{ position == game.currentTurn - 1 ? ' data-current-turn' : '' }}>{{ constant('App\\Rules\\ScoreCalculator::POINTS_PER_AST_POSITION') * position }}</td>
            {% endfor %}
            <td></td>
        </tr>
    </tfoot>
</table>
