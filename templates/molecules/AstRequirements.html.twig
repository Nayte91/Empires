{% props eras, astVersion %}

<section class="ast-requirements">
    <twig:atoms:Label>A.S.T. requirements ({{ astVersion }})</twig:atoms:Label>
    <ul>
        {% for era in eras %}
            {% set requirements = astVersion == 'expert' ? era.expertRequirements : era.basicRequirements %}
            {% set parts = [] %}
            {% for key, value in requirements %}
                {% set parts = parts|merge([(key|replace({'_': ' '})|capitalize) ~ ': ' ~ value]) %}
            {% endfor %}
            <li>
                <strong>{{ era.name }}:</strong> {{ parts is empty ? 'No requirements' : parts|join(', ') }}
            </li>
        {% endfor %}
    </ul>
</section>
