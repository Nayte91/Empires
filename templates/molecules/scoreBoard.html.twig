<table
    {{ attributes.defaults(stimulus_controller('mercure-refresh', {topic: 'empires/game/' ~ game.id, events: ['player-updated', 'game-updated']})) }}
    data-players
    class="score-board"
>
    <caption>Turn {{ game.currentTurn }}</caption>
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Empire</th>
            <th scope="col">Treasury</th>
            <th scope="col">Census</th>
            <th scope="col">Ships</th>
            <th scope="col">Cities</th>
            <th scope="col">Cards</th>
            <th scope="col">Advances</th>
            <th scope="col">VP</th>
        </tr>
    </thead>
    <tbody>
        {% for row in this.playerRows %}
            {% set player = row.player %}
            <tr>
                <td>
                    <twig:molecules:Modal class="game-dashboard__name-modal">
                        <twig:block name="button">
                            {{ player.name }}
                        </twig:block>
                        <twig:block name="content">
                            <h2>{{ player.name }}</h2>
                            {{ row.qr|raw }}
                            <p class="game-dashboard__qr-url"><a href="{{ row.url }}">{{ row.url }}</a></p>
                            <button type="button" {{ stimulus_action('modal', 'close') }}>Close</button>
                        </twig:block>
                    </twig:molecules:Modal>
                </td>
                <td data-empire="{{ player.empire }}">{{ this.empireAdjective(player) ?? '—' }}</td>
                <td>{{ player.treasury }}</td>
                <td>{{ player.census }}</td>
                <td>{{ player.ships }}</td>
                <td{{ player.cities > 0 ? ' data-scored' : '' }}>{{ player.cities }}</td>
                <td>{{ player.cards }}</td>
                <td{{ player.advances|length > 0 ? ' data-scored' : '' }}>{{ player.advances|length }}</td>
                <td{{ row.victoryPoints > 0 ? ' data-scored' : '' }}>{{ row.victoryPoints }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">No players yet.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
